{
  "name": "dr-docs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "bootstrap": "npm install --workspaces",
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "node --test --test-reporter=tap tests/**/*.test.js",
    "test:watch": "node --test --watch --test-reporter=tap tests/**/*.test.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "sharp": "^0.34.5"
  }
}
